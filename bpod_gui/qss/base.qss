QWidget {
    font-family: 'Courier New';
    font-size: 14px;
}

QLabel[type="header"] {
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-radius: 0px;
    border-color: grey;
    margin-bottom: 5px;
}

QLabel[type="header_no_ul"] {
    border-bottom-width: 2px;
    border-bottom-style: solid;
    border-radius: 0px;
    border-color: grey;
    margin-bottom: 5px;
}